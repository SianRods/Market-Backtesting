# Docker Compose PostgreSQL settings for local development only.
POSTGRES_DB=backtesting
POSTGRES_USER=backtesting
POSTGRES_PASSWORD=backtesting
POSTGRES_PORT=5432

# Spring application settings.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/backtesting
DB_USERNAME=backtesting
DB_PASSWORD=backtesting
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
TICKER_SEEDER_ENABLED=true
SERVER_PORT=8080

# Set true only once when adopting a pre-Flyway database that already has the
# repository's Phase 2 baseline schema. Keep false for a clean database.
FLYWAY_BASELINE_ON_MIGRATE=false

# Yahoo is an unofficial educational/demo adapter. Keep request volume low.
YAHOO_CONNECT_TIMEOUT=3s
YAHOO_RESPONSE_TIMEOUT=10s
YAHOO_REQUEST_TIMEOUT=15s
YAHOO_MAX_ATTEMPTS=3
YAHOO_INITIAL_BACKOFF=250ms
YAHOO_MAX_BACKOFF=3s
MARKET_DATA_CLOSE_GRACE=20m
MARKET_DATA_CORRECTION_OVERLAP_DAYS=5
