# Docker Compose PostgreSQL settings for local development only.
POSTGRES_DB=backtesting
POSTGRES_USER=backtesting
POSTGRES_PASSWORD=backtesting
POSTGRES_PORT=5432

# Spring application settings.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/backtesting
DB_USERNAME=backtesting
DB_PASSWORD=backtesting
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
TICKER_SEEDER_ENABLED=true
SERVER_PORT=8080
